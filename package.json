{
  "name": "resume-builder",
  "version": "0.1.0",
  "description": "AI-powered CV builder with Claude agent orchestration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @resume-builder/browser-app dev",
    "dev:api": "ENABLE_V2_API=true pnpm --filter @resume-builder/api dev",
    "dev:all": "ENABLE_V2_API=true concurrently \"pnpm dev:api\" \"pnpm dev\"",
    "dev:v2": "ENABLE_V2_API=true concurrently \"pnpm dev:api\" \"pnpm dev\"",
    "build": "pnpm --recursive --if-present build",
    "prebuild": "pnpm security:check",
    "preview": "pnpm --filter @resume-builder/browser-app preview",
    "start:api": "pnpm --filter @resume-builder/api start",
    "cli": "pnpm --filter @resume-builder/agent-core cli",
    "cli:headless": "pnpm --filter @resume-builder/agent-core cli:headless",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "type-check": "pnpm --recursive --if-present type-check",
    "postbuild": "pnpm dlx tsx scripts/artifact-scanner.ts",
    "security:check": "bash scripts/security-check.sh",
    "security:scan": "bash scripts/security-scan.sh",
    "security:verify": "bash scripts/security-verify.sh",
    "prepare": "husky install || echo 'Husky not installed, skipping git hooks'",
    "docker:build": "docker build -t cv-builder-agents .",
    "docker:run": "docker run -it --rm -v $(pwd)/data:/app/data --env-file .env.local cv-builder-agents",
    "screenshots:cleanup": "tsx scripts/cleanup-screenshots.ts",
    "screenshots:cleanup:dry-run": "tsx scripts/cleanup-screenshots.ts --dry-run",
    "screenshots:promote": "tsx scripts/promote-screenshots-to-docs.ts",
    "screenshots:promote:dry-run": "tsx scripts/promote-screenshots-to-docs.ts --dry-run",
    "clean": "pnpm --recursive exec rm -rf node_modules dist && rm -rf node_modules",
    "lerna:version": "lerna version",
    "lerna:publish": "lerna publish"
  },
  "keywords": [
    "cv",
    "resume",
    "ai",
    "claude",
    "career"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@frame/eslint-plugin": "workspace:^",
    "@types/node": "^22.9.0",
    "@typescript-eslint/parser": "^8.58.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.2.0",
    "husky": "^8.0.3",
    "lerna": "^9.0.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "react-redux": "^9.2.0"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": ">=1.1.38 <1.2.0",
      "langchain": ">=1.2.39",
      "@langchain/langgraph-sdk": ">=0.0.112 <2.0.0",
      "qs": ">=6.14.1 <7.0.0",
      "fast-xml-parser": ">=5.5.6 <6.0.0",
      "underscore": ">=1.13.8",
      "immutable": ">=5.1.5",
      "handlebars": ">=4.7.9",
      "picomatch": ">=4.0.4",
      "@xmldom/xmldom": ">=0.8.12"
    },
    "comment": "Override @langchain/core to >=1.1.38 <1.2.0 to resolve peer dependency conflicts and ensure the standard_schema export exists (required by @langchain/openai >=1.3.0 and @langchain/anthropic >=1.3.0). langchain >=1.2.39 and fast-xml-parser >=5.5.6 fixes GHSA-8gc5-j5rx-235r (numeric entity expansion bypass). qs >=6.14.1 fixes GHSA-6rw7-vpxm-498p (DoS via memory exhaustion) in express. @langchain/langgraph-sdk <2.0.0 avoids the deprecated 2.0.0 release. underscore >=1.13.8 fixes GHSA-qpx9-hpmf-5gmw. immutable >=5.1.5 fixes GHSA-wf6x-7x77-mvgw. handlebars >=4.7.9 fixes GHSA-3mfm-83xf-c92r. picomatch >=4.0.4 fixes GHSA-c2c7-rcm5-vvqj. Note: path-to-regexp override removed — Express 4 bundles 0.1.x which is unaffected, and overriding to >=0.1.13 resolves to v8+ which breaks Express's API."
  }
}

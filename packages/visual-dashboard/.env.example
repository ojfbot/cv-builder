# Visual Dashboard — Environment Variables
# Copy to .env.local and fill in your values.
# These are injected at build time by Vite (all VITE_* vars are public).

# Public S3 bucket base URL for CI screenshot pipeline output.
# e.g. https://my-bucket-<ACCOUNT_ID>-us-east-1.s3.us-east-1.amazonaws.com
VITE_S3_BASE_URL=https://ojfbot-cv-builder-<YOUR_ACCOUNT_ID>-us-east-1.s3.us-east-1.amazonaws.com

# S3 key namespace — must match GITHUB_REPOSITORY in the CI pipeline.
# Default is derived from ojfbot/cv-builder → ojfbot-cv-builder.
# Only override if you fork or rename the repo.
# VITE_S3_PREFIX=ojfbot-cv-builder
